# =============================================================================
# TRACE — Environment Variables Reference
# Copy this to .env and fill in real values. Never commit .env.
# Source of truth for which vars exist: services/api/core/config.py
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE (REQUIRED)
# Defaults to the local Postgres container in infra/docker-compose.yml — start it with
#   docker compose -f infra/docker-compose.yml up -d
# then `alembic upgrade head` and `python scripts/seed_db.py`. No account needed.
# To use a managed Postgres instead, replace the URL and set DATABASE_SSL_REQUIRED=true.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5432/talent_platform
# Set to true for a remote/managed endpoint that requires TLS. Leave false for local Docker.
DATABASE_SSL_REQUIRED=false

# Local Redis container from the same compose file. Backs the background job queue
# (arq) that runs candidate ingestion, job matching, assessment grading, deck analysis,
# and hackathon ranking — consumed by `python -m services.workers.runner`.
REDIS_URL=redis://localhost:6379

# Background job queue. If Redis is unreachable (or QUEUE_ENABLED=false), the API falls
# back to running these jobs in-process, so a worker is not strictly required for local
# development — you just lose durability across restarts and retries on transient errors.
QUEUE_ENABLED=true
# Per-job ceiling. Must exceed the slowest pipeline (large GitHub crawl, multi-team
# hackathon finalization) or arq will cancel work that would have succeeded.
QUEUE_JOB_TIMEOUT_SECONDS=900
# Total attempts including the first; only transient failures (timeout, connection,
# rate limit, upstream 5xx) are retried. Backoff doubles from the base delay.
QUEUE_MAX_TRIES=3
QUEUE_RETRY_BASE_DELAY_SECONDS=5
QUEUE_RESULT_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# 2. AUTHENTICATION — SELF-HOSTED JWT (REQUIRED)
# Auth is bcrypt password hashing plus HS256 JWTs issued by this API. There is no
# external identity provider: services/api/core/config.py reads only the three
# settings below, and `jwt_secret_key` is the one value with no default — the API
# will not start without it.
# Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# 7 days. Tokens are stateless, so shortening this is the only way to bound the
# window on a leaked token.
JWT_EXPIRY_SECONDS=604800

# -----------------------------------------------------------------------------
# 3. MULTI-PROVIDER LLM GATEWAY (Anthropic, OpenAI, Grok, Gemini, Custom API)
# Set LLM_PROVIDER to "anthropic", "openai", "grok", "gemini", or "openai_compatible".
# Supply the matching API key below for your chosen provider.
# -----------------------------------------------------------------------------
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROK_API_KEY=
GEMINI_API_KEY=
LLM_BASE_URL=
LLM_MODEL_FAST=claude-haiku-4-5-20251001
LLM_MODEL_JUDGMENT=claude-sonnet-4-6

# -----------------------------------------------------------------------------
# 4. GITHUB OAUTH (REQUIRED for GitHub ingestion — FR-1)
# Create an OAuth App at https://github.com/settings/developers
# Callback: http://localhost:3000/api/auth/github/callback (dev)
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# -----------------------------------------------------------------------------
# 5. CLOUDINARY FILE STORAGE (REQUIRED for resume PDF + deck storage)
# FR-5: stores generated resume PDFs. Module 04: stores uploaded decks.
# Without this, upload/store calls return 503 — no crash.
# Get from https://cloudinary.com -> Dashboard -> "API Keys"
# URL format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# -----------------------------------------------------------------------------
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# -----------------------------------------------------------------------------
# 6. VECTOR DB — QDRANT (REQUIRED for FR-4 skill-gap and Module 04 plagiarism)
# Runs as the local Qdrant container in infra/docker-compose.yml (no API key needed).
# Dashboard: http://localhost:6333/dashboard
# -----------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# -----------------------------------------------------------------------------
# 7. SALARY MODEL — FR-4.4 (optional, graceful degrade without it)
# Produce the .joblib artifact by running:
#   python services/agents/candidate_intelligence/tools/train_salary_model.py
# (downloads Stack Overflow Developer Survey CSV, trains a Ridge regressor)
# Leave blank to use the default path.
# -----------------------------------------------------------------------------
SALARY_MODEL_PATH=data/models/salary_regressor.joblib

# -----------------------------------------------------------------------------
# 8. PPT ANALYZER — MODULE 04
# Max upload size in MB (enforced at route level before streaming to storage).
# LibreOffice binary for .ppt -> .pptx conversion. Install headless LibreOffice
# and point LIBREOFFICE_BINARY to the `soffice` binary if you need legacy .ppt support.
# Without it, .pptx uploads work fine; .ppt uploads return a clear 422 error.
# -----------------------------------------------------------------------------
PRESENTATION_MAX_FILE_SIZE_MB=50
LIBREOFFICE_BINARY=soffice

# -----------------------------------------------------------------------------
# 9. FRONTEND / CORS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Where Pyodide fetches its WASM runtime and stdlib assets. Coding assessments run
# candidate code entirely client-side and depend on these, so a CDN outage disables the
# feature outright; point this at a self-hosted copy to remove that dependency. The
# version must stay pinned to a matching Pyodide release.
NEXT_PUBLIC_PYODIDE_INDEX_URL=https://cdn.jsdelivr.net/pyodide/v0.26.4/full/

# -----------------------------------------------------------------------------
# 10. OBSERVABILITY (optional — features work without these)
# Langfuse: LLM call tracing (LangGraph integration)
# Sentry: runtime error tracking (backend + frontend)
# -----------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=

# -----------------------------------------------------------------------------
# 11. MISC
# -----------------------------------------------------------------------------
ENVIRONMENT=development
RATE_LIMIT_PER_MINUTE=600

# Shared secret required by POST /hackathons/{id}/webhook. Leave empty to disable the
# endpoint; it performs unauthenticated writes, so it stays off until this is set.
HACKATHON_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 12. LLM RELIABILITY (optional — sane defaults, override only if you need to)
#
# The gateway retries transient provider failures (429 rate limits, timeouts, 5xx
# overload, malformed structured output) with exponential backoff + jitter. It never
# retries an exhausted quota or bad credentials: those cannot succeed on a second
# identical attempt, so retrying only delays the error.
# -----------------------------------------------------------------------------
# Per-call ceiling passed to the provider SDK. Backstop against a hung socket, not a
# latency target — judgment-tier calls over long transcripts legitimately take a while.
LLM_TIMEOUT_SECONDS=60
# Additional attempts after the first. Kept low: agent pipelines chain many calls, so a
# high per-call retry count multiplies into minutes of user-visible wait.
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=1
# Output-token budgets — the single largest per-call cost driver.
LLM_MAX_TOKENS_SMALL=256
LLM_MAX_TOKENS_DEFAULT=1024
LLM_MAX_TOKENS_LARGE=2048
# Temperature for calls that must be reproducible across runs (rubric scoring).
LLM_TEMPERATURE_DETERMINISTIC=0

# -----------------------------------------------------------------------------
# 13. SCORING WEIGHTS & THRESHOLDS (optional)
#
# Defaults reproduce the previously-hardcoded behaviour exactly; these exist so a
# deployment can retune without a code change. Talent Score weights are renormalized
# over whichever sub-scores actually resolved, but they should still sum to 1.0.
# services/api/tests/test_config_parity.py pins every default below.
# -----------------------------------------------------------------------------
WEIGHT_CODING_ABILITY=0.16
WEIGHT_PROBLEM_SOLVING=0.16
WEIGHT_PROJECT_QUALITY=0.12
WEIGHT_INNOVATION=0.12
WEIGHT_TECHNICAL_CONSISTENCY=0.08
WEIGHT_COMMUNITY_PARTICIPATION=0.08
WEIGHT_LEADERSHIP=0.08
WEIGHT_OPEN_SOURCE_CONTRIBUTIONS=0.10
WEIGHT_HACKATHON_PERFORMANCE=0.10

# Job-match formula (must also sum to 1.0).
MATCH_WEIGHT_SKILL_OVERLAP=0.35
MATCH_WEIGHT_SEMANTIC_SIMILARITY=0.30
MATCH_WEIGHT_EXPERIENCE_MATCH=0.15
MATCH_WEIGHT_TALENT_SCORE_ALIGNMENT=0.20
MATCH_SEMANTIC_ALPHA=0.70

# Similarity thresholds. Named per purpose: these are deliberately different numbers for
# different jobs. SKILL_SIMILARITY_THRESHOLD is calibrated against EMBEDDING_MODEL above —
# changing the model invalidates this value.
SKILL_SIMILARITY_THRESHOLD=0.80
SKILL_GAP_SIMILARITY_THRESHOLD=0.72
TEXT_FINGERPRINT_SIMILARITY_THRESHOLD=0.80
STRUCTURAL_SIMILARITY_THRESHOLD=0.75
DECK_PLAGIARISM_SIMILARITY_THRESHOLD=0.90
PHOTO_HASH_DISTANCE_THRESHOLD=4

# Below this many comparable candidates, percentile normalization returns a neutral
# midpoint rather than a falsely-confident percentile.
MIN_POPULATION_FOR_PERCENTILE=30
MIN_POPULATION_FOR_ASSESSMENT_PERCENTILE=10

# -----------------------------------------------------------------------------
# 14. AGENT BOUNDS (optional — cost, latency and loop-termination controls)
# -----------------------------------------------------------------------------
# Worst-case interview length is 2 x INTERVIEW_MAX_TOPICS turns, at two judgment-tier
# LLM calls per turn. These two numbers decide the ceiling on a single interview's cost.
MAX_FOLLOWUPS_PER_TOPIC=1
INTERVIEW_MAX_TOPICS=12
INTERVIEW_MAX_VERBATIM_TURNS=6
INTERVIEW_MAX_TURN_CHARS=1200
DOCUMENT_GENERATION_MAX_ATTEMPTS=2
RECRUITMENT_SHORTLIST_LIMIT=50
GITHUB_MAX_REPOS=15
AGENT_MAX_CONCURRENCY=5

# -----------------------------------------------------------------------------
# 15. TIMEOUTS, TTLs AND PAGE CAPS (optional)
# -----------------------------------------------------------------------------
GITHUB_HTTP_TIMEOUT_SECONDS=15
LEETCODE_HTTP_TIMEOUT_SECONDS=15
ISSUER_LOOKUP_TIMEOUT_SECONDS=6
PHOTO_FETCH_TIMEOUT_SECONDS=8
OAUTH_EXCHANGE_TIMEOUT_SECONDS=10
QDRANT_TIMEOUT_SECONDS=5
LIBREOFFICE_TIMEOUT_SECONDS=60
CAREER_RECOMMENDATION_TTL_HOURS=24
GITHUB_OAUTH_STATE_TTL_SECONDS=600
STATS_REFRESH_COOLDOWN_MINUTES=15
MAX_DASHBOARD_PROJECTS=50
MAX_SCORE_HISTORY=30
CANDIDATE_POOL_CACHE_TTL_SECONDS=30
MAX_CANDIDATE_POOL=5000
EVENT_POLL_INTERVAL_SECONDS=30

# Salary prediction. The regression is trained on a global survey, so the currency label
# is configurable rather than assuming USD.
SALARY_CURRENCY=USD
SALARY_TALENT_SCORE_MAX_ADJUSTMENT=0.15
SALARY_TALENT_SCORE_BASELINE=50
